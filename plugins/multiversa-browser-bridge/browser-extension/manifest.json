{
  "manifest_version": 3,
  "name": "Multiversa Browser Bridge",
  "description": "Controls an explicitly authorized Gmail, Hotmart or ManyChat tab from the local Multiversa CLI without exporting browser sessions.",
  "version": "0.2.0",
  "action": {
    "default_title": "Multiversa Browser Bridge",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
